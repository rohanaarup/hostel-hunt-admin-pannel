# Environment variable NAMES for the Hostel Hunt backend. No values here.
# Copy to .env for local development; on a server set them in the host's
# environment instead. Never commit a real .env.
# Put comments on their own lines: a trailing "# ..." becomes part of the value.

# ---- Required when DEBUG is off (the server refuses to start without them) ----
SECRET_KEY=
# Comma-separated hostnames, e.g. api.example.com
ALLOWED_HOSTS=
# Postgres URL (used when USE_DB is unset or "supabase")
DATABASE_URL=

# ---- Mode ----
# Local development only. Default is off.
# DEBUG=True
# sqlite | local | supabase (default: supabase)
# USE_DB=sqlite
# Used when USE_DB=local
# LOCAL_DATABASE_URL=

# ---- Browsers / HTTPS (all optional) ----
# Comma-separated, with scheme, e.g. https://admin.example.com. Default: none.
# CORS_ALLOWED_ORIGINS=
# Comma-separated, with scheme. Needed for /admin/ login over HTTPS.
# CSRF_TRUSTED_ORIGINS=
# Behind Cloudflare in front of Render there are TWO proxies: set TRUSTED_PROXY_COUNT=2 only after the two-phone test
# in docs/EDGE_SETUP.md shows two different `client` values in the request log. Use the new domain in ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS (comma-separated, all through the environment).
# A shared secret the edge adds as the header X-Edge-Secret: requests without it get 403 (the health checks are
# exempt). Holds a secret: set it in the host's environment and the edge's transform rule only, never in a file.
# EDGE_SHARED_SECRET=
# Put a masked, daily-rotating client identifier in each request log line (default True; False removes it).
# LOG_CLIENT_ID=
# Set False only if gunicorn is not behind a TLS-terminating proxy.
# TRUST_PROXY_SSL_HEADER=True
# Default: on when DEBUG is off.
# SECURE_SSL_REDIRECT=True
# Default 0. Raise only after HTTPS is proven.
# SECURE_HSTS_SECONDS=0

# ---- Database timeouts and caching (optional) ----
# Seconds to wait for a new database connection (default 5).
# DB_CONNECT_TIMEOUT=
# session (default) or transaction: the kind of pooler in front of the database (Supabase: port 5432 session,
# port 6543 transaction). Transaction mode turns off server-side cursors and prepared statements and applies the
# statement timeout per transaction. See docs/CAPACITY.md before switching; run `manage.py pool_check` after.
# DB_POOL_MODE=
# Longest one statement may run, in milliseconds (default 0 = no limit). Set it on the WEB process only
# (in front of the gunicorn command), never where migrations or the clean-up job run.
# DB_STATEMENT_TIMEOUT_MS=
# Seconds the public cities and localities lists are kept (default 60, jittered by 10 percent; 0 = off). Shared by
# every worker and instance when REDIS_URL is set, per process otherwise.
# PUBLIC_LIST_CACHE_SECONDS=
# Shared cache (Render Key Value or any Redis). Holds a password: set it in the host's environment only, never in a
# file. Empty = per-process memory cache (local runs, most of CI). A Redis outage never takes the API down: the
# cache fails open (rate limits stop counting) and is retried every REDIS_BREAKER_SECONDS.
# REDIS_URL=
# Seconds to wait for a Redis connection and for one reply (defaults 0.25 and 0.5).
# REDIS_CONNECT_TIMEOUT=
# REDIS_SOCKET_TIMEOUT=
# Connections per worker process to Redis (default 20) and the cool-down after a failure in seconds (default 10).
# REDIS_MAX_CONNECTIONS=
# REDIS_BREAKER_SECONDS=
# Request limits per address (anon, public browsing) and per signed-in user. Defaults 60/min and 120/min.
# Raise them on STAGING ONLY for a load test (LOADTEST.md), then remove them. Leave unset in production.
# THROTTLE_ANON=
# THROTTLE_USER=
# Compress responses in Django (default on; Render's edge compresses too, your own server would not).
# GZIP_RESPONSES=

# ---- Auth tokens (optional) ----
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=30

# ---- Email for OTP codes ----
# Render's free plan blocks SMTP, so use an HTTPS email API: EMAIL_API_PROVIDER is brevo or resend and
# EMAIL_API_KEY is the provider's key (a secret). DEFAULT_FROM_EMAIL must be a sender the provider has
# verified (Brevo: one verified address is enough; Resend: needs a verified domain).
# EMAIL_API_PROVIDER=
# EMAIL_API_KEY=
# SMTP is the fallback for a server that allows it. EMAIL_TIMEOUT (seconds, default 5) is its socket timeout.
# EMAIL_TIMEOUT=
# How many proxies sit in front of gunicorn (Render: 1). Used to read the real client address for rate limits.
# TRUSTED_PROXY_COUNT=
# SMTP settings:
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# ---- Cloudinary: profile photo uploads (optional; photo upload returns 503 without them) ----
# The cloud name and an UNSIGNED upload preset from the Cloudinary dashboard. No API secret.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# ---- Twilio SMS (not integrated yet) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Deployment kind (optional) ----
# production | staging | development. Default: development when DEBUG is on, else production.
# staging enables Swagger UI and allows the seed_staging command. Never set it on production.
# APP_ENV=

# ---- Development only ----
# With DEBUG=True, shows OTPs in responses and logs. Never in production.
# EXPOSE_DEV_OTP=True

# ---- Observability (all optional) ----
# Sentry project DSN for this backend. Empty means Sentry is off.
# SENTRY_DSN=
# production | staging | test. Default: production, or development when DEBUG is on.
# SENTRY_ENVIRONMENT=
# Version tag for events and log lines. Falls back to GIT_COMMIT.
# SENTRY_RELEASE=
# GIT_COMMIT=
# Fraction of requests traced, 0 to 1. Default 0 (the request log covers latency).
# SENTRY_TRACES_SAMPLE_RATE=0
# Heartbeat monitor for the scheduled clean-up job (the cron runs `manage.py ping_heartbeat cleanup_expired`).
# HEARTBEAT_URL is called after a successful run and holds a secret token: set it in the cron's environment
# only, never in a file. HEARTBEAT_FAIL_URL is called after a failed run; default is HEARTBEAT_URL plus /fail.
# Both empty: the job simply runs with no monitoring.
# HEARTBEAT_URL=
# HEARTBEAT_FAIL_URL=
# Set to - to turn on gunicorn's own access log.
# GUNICORN_ACCESSLOG=

# ---- Checks (optional) ----
# Comma-separated Django system check ids to silence, e.g. security.W004. Used by CI.
# SILENCED_SYSTEM_CHECKS=

# ---- Operations (optional) ----
# DB_CONN_MAX_AGE=60
# DJANGO_LOG_LEVEL=INFO
# gunicorn bind port (most hosts set this)
# PORT=8000
# gunicorn workers
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
