# Environment variable NAMES for the Hostel Hunt backend. No values here.
# Copy to .env for local development; on a server set them in the host's
# environment instead. Never commit a real .env.
# Put comments on their own lines: a trailing "# ..." becomes part of the value.

# ---- Required when DEBUG is off (the server refuses to start without them) ----
SECRET_KEY=
# Comma-separated hostnames, e.g. api.example.com
ALLOWED_HOSTS=
# Postgres URL (used when USE_DB is unset or "supabase")
DATABASE_URL=

# ---- Mode ----
# Local development only. Default is off.
# DEBUG=True
# sqlite | local | supabase (default: supabase)
# USE_DB=sqlite
# Used when USE_DB=local
# LOCAL_DATABASE_URL=

# ---- Browsers / HTTPS (all optional) ----
# Comma-separated, with scheme, e.g. https://admin.example.com. Default: none.
# CORS_ALLOWED_ORIGINS=
# Comma-separated, with scheme. Needed for /admin/ login over HTTPS.
# CSRF_TRUSTED_ORIGINS=
# Set False only if gunicorn is not behind a TLS-terminating proxy.
# TRUST_PROXY_SSL_HEADER=True
# Default: on when DEBUG is off.
# SECURE_SSL_REDIRECT=True
# Default 0. Raise only after HTTPS is proven.
# SECURE_HSTS_SECONDS=0

# ---- Database timeouts and caching (optional) ----
# Seconds to wait for a new database connection (default 5).
# DB_CONNECT_TIMEOUT=
# Longest one statement may run, in milliseconds (default 0 = no limit). Set it on the WEB process only
# (in front of the gunicorn command), never where migrations or the clean-up job run.
# DB_STATEMENT_TIMEOUT_MS=
# Seconds the public cities and localities lists are kept in memory per worker (default 60, 0 = off).
# PUBLIC_LIST_CACHE_SECONDS=
# Compress responses in Django (default on; Render's edge compresses too, your own server would not).
# GZIP_RESPONSES=

# ---- Auth tokens (optional) ----
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=30

# ---- Email for OTP codes ----
# Render's free plan blocks SMTP, so use an HTTPS email API: EMAIL_API_PROVIDER is brevo or resend and
# EMAIL_API_KEY is the provider's key (a secret). DEFAULT_FROM_EMAIL must be a sender the provider has
# verified (Brevo: one verified address is enough; Resend: needs a verified domain).
# EMAIL_API_PROVIDER=
# EMAIL_API_KEY=
# SMTP is the fallback for a server that allows it. EMAIL_TIMEOUT (seconds, default 5) is its socket timeout.
# EMAIL_TIMEOUT=
# How many proxies sit in front of gunicorn (Render: 1). Used to read the real client address for rate limits.
# TRUSTED_PROXY_COUNT=
# SMTP settings:
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# ---- Cloudinary: profile photo uploads (optional; photo upload returns 503 without them) ----
# The cloud name and an UNSIGNED upload preset from the Cloudinary dashboard. No API secret.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# ---- Twilio SMS (not integrated yet) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Deployment kind (optional) ----
# production | staging | development. Default: development when DEBUG is on, else production.
# staging enables Swagger UI and allows the seed_staging command. Never set it on production.
# APP_ENV=

# ---- Development only ----
# With DEBUG=True, shows OTPs in responses and logs. Never in production.
# EXPOSE_DEV_OTP=True

# ---- Observability (all optional) ----
# Sentry project DSN for this backend. Empty means Sentry is off.
# SENTRY_DSN=
# production | staging | test. Default: production, or development when DEBUG is on.
# SENTRY_ENVIRONMENT=
# Version tag for events and log lines. Falls back to GIT_COMMIT.
# SENTRY_RELEASE=
# GIT_COMMIT=
# Fraction of requests traced, 0 to 1. Default 0 (the request log covers latency).
# SENTRY_TRACES_SAMPLE_RATE=0
# Set to - to turn on gunicorn's own access log.
# GUNICORN_ACCESSLOG=

# ---- Checks (optional) ----
# Comma-separated Django system check ids to silence, e.g. security.W004. Used by CI.
# SILENCED_SYSTEM_CHECKS=

# ---- Operations (optional) ----
# DB_CONN_MAX_AGE=60
# DJANGO_LOG_LEVEL=INFO
# gunicorn bind port (most hosts set this)
# PORT=8000
# gunicorn workers
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
