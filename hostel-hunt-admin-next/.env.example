# Copy to .env.local for development. The site refuses to build or start without NEXT_PUBLIC_API_URL.
# These are public (they end up in the browser); never put a secret here.

# The backend's /api/v1 address.
#   development: http://127.0.0.1:8000/api/v1
#   staging:     https://hostel-hunt-admin-pannel.onrender.com/api/v1
#   production:  https://hostel-hunt-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Cloudinary (browser uploads of hostel photos and videos): the cloud name and an UNSIGNED upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
